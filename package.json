{
  "name": "dsh-lego-io-preview",
  "version": "0.2.0",
  "description": "Read-only 3D preview for BrickLink Studio .io LEGO models in the DSH right sidebar.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lego",
    "ldraw",
    "bricklink",
    "studio",
    "3d",
    "preview"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HMYoung/dsh-lego-io-preview.git"
  },
  "homepage": "https://github.com/HMYoung/dsh-lego-io-preview#readme",
  "bugs": {
    "url": "https://github.com/HMYoung/dsh-lego-io-preview/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
